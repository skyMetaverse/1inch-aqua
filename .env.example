# 由 bun run encrypt-private-key 写入；不要提交真实密文或私钥。
ENCRYPTED_PRIVATE_KEY=

# 必须是可读取基础费、估算 gas 并广播 eth_sendRawTransaction 的 RPC。
RPC_URL=https://your-rpc.example

# 可选：两项必须同时填写，单位为 gwei，最多 9 位小数。
# 每笔交易仍从最新链上区块读取 baseFeePerGas；若 MAX_FEE_PER_GAS_GWEI 小于 base fee 加 priority fee，交易会在本地拒绝签名。
# 留空时使用 RPC 的 EIP-1559 费率估算。
MAX_FEE_PER_GAS_GWEI=
MAX_PRIORITY_FEE_PER_GAS_GWEI=
